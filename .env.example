# Copiá este archivo a .env.local y completalo. Las mismas variables van en Vercel.

# Dominio canónico: el host que REALMENTE sirve la web (con o sin www; ver README).
NEXT_PUBLIC_SITE_URL=https://www.mbk.com.ar

# Opcional: pisa el WhatsApp de MBK (+54 9 2954 36-2919, ya cargado en content/site.ts).
# Formato internacional sin + ni espacios. Dejar vacío para usar el de siempre.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Conexión al Supabase del sistema (proyecto mbk-system). Obligatoria: sin estas dos
# variables el formulario responde con un error claro y muestra el WhatsApp como
# alternativa (nunca simula un envío) y la medición no guarda nada.
# La clave "publishable" es pública por diseño: solo puede llamar a submit_web_lead y
# track_web_event. Va solo en el servidor (sin NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Aviso por mail (Resend): OPCIONAL, de apoyo. La consulta ya llega al panel de la asesora.
# Si se completan las tres, además se manda un mail a MBK.
RESEND_API_KEY=
# Mail de Belén donde llegan los interesados (varios separados por coma).
CONTACT_TO_EMAIL=
# Remitente. Tiene que ser de un dominio verificado en Resend, ej.:
# MBK Web <web@mbk.com.ar>   (para probar: onboarding@resend.dev)
CONTACT_FROM_EMAIL=
